MODEL_NAME=${MODEL_NAME:-Qwen/Qwen2.5-7B-Instruct}
MODEL_PATH=${MODEL_PATH:-$MODEL_NAME}
TOKENIZER_MODEL_NAME=${TOKENIZER_MODEL_NAME:-$MODEL_NAME}
LEARNING_RATE=${LEARNING_RATE:-2e-5}
NUM_TRAIN_EPOCHS=${NUM_TRAIN_EPOCHS:-1}
MAX_STEPS=${MAX_STEPS:--1}
SAVE_STEPS=${SAVE_STEPS:-50}
SAVE_TOTAL_LIMIT=${SAVE_TOTAL_LIMIT:-4}
REPORT_TO=${REPORT_TO:-none}
SEED=${SEED:-42}
MAX_PROMPT_LENGTH=${MAX_PROMPT_LENGTH:-2048}
MAX_COMPLETION_LENGTH=${MAX_COMPLETION_LENGTH:-4096}
MAX_SFT_LENGTH=${MAX_SFT_LENGTH:-6144}
PARTIAL_RATIO=${PARTIAL_RATIO:-0.5}
CHECKPOINT_ROOT=${CHECKPOINT_ROOT:-$ROOT_DIR/checkpoints}
ARTIFACT_ROOT=${ARTIFACT_ROOT:-$ROOT_DIR/artifacts}
